!<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyShop</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
        }

        /* Navigation Bar */
        .navbar {
            background-color: #17212b;
            color: white;
            padding: 15px 20px;
        }

        .nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .menu {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        .menu li a {
            color: white;
            text-decoration: none;
        }

        .menu li a:hover {
            color: yellow;
        }

        .hamburger {
            display: none;
            font-size: 28px;
            cursor: pointer;
            background: none;
            border: none;
            color: white;
        }

        /* Main Content */
        .container {
            padding: 40px;
        }

        h1 {
            margin-bottom: 20px;
        }

        /* Mobile Responsive */
        @media (max-width: 600px) {

            .hamburger {
                display: block;
            }

            .menu {
                display: none;
                flex-direction: column;
                gap: 0;
                margin-top: 15px;
            }

            .menu li {
                padding: 20px;
            }

            .menu.show {
                display: flex;
            }

        }
    </style>
</head>

<body>

    <nav class="navbar">

        <div class="nav-header">
            <div class="logo">MyShop</div>

            <button class="hamburger" onclick="toggleMenu()">
                ☰
            </button>
        </div>

        <ul class="menu" id="menu">
            <li><a href="#">Home</a></li>
            <li><a href="#">Products</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>

    </nav>

    <div class="container">
        <h1>Welcome to MyShop</h1>
        <p>Resize the browser window to see the menu change.</p>
    </div>

    <script>
        function toggleMenu() {
            let menu = document.getElementById("menu");
            menu.classList.toggle("show");
        }
    </script>

</body>
</html>
